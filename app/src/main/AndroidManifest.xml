<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline boundary: no INTERNET permission, ever. -->
    <!-- media3-session requests ACCESS_NETWORK_STATE transitively; PRD 7.14
         minimal permission set does not include it, so strip it at merge time. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for folder artwork, and only for that.
         =
         Removing this on 2026-10-18 broke every album whose cover is a `cover.jpg` or `folder.jpg`
         sitting next to the audio: the scan resolves those with `File.listFiles` on the album's
         directory, and the image pipeline then opens the resolved path. Without all-files access
         the app cannot even list `/storage/emulated/0/Music`, so 87 albums fell back to the
         placeholder and albums that still had a `/storage/...` path in the database showed nothing.
         The removal was argued from "no code references it", which was true and beside the point:
         the permission is what makes those file paths readable at all.
         =
         It is not a permission to read the library - the media index is read with READ_MEDIA_AUDIO,
         and the full-scan switch gates that. It is requested only when the reader turns full scan
         on, and the settings page explains what it is for. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".SertumApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sertum">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ships inside media3-session and would otherwise be the only exported activity in the
             app besides MainActivity. It is the library's Bluetooth-session validation screen,
             which nothing here starts; removing it keeps "what can another app launch in this
             app" down to the launcher. Same merge-time removal already used for
             ACCESS_NETWORK_STATE above. -->
        <activity
            android:name="androidx.media3.session.BluetoothValidationActivity"
            tools:node="remove" />

        <service
            android:name=".audio.session.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
